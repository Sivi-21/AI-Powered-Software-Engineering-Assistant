# # =========================
# # Project Configuration
# # =========================
# PROJECT_NAME=AI-Powered Software Engineering Assistant
# API_V1_STR=/api/v1

# # =========================
# # Database
# # =========================
# MONGO_URI=YOUR_MONGODB_CONNECTION_STRING
# MONGO_DB_NAME=codesphere_ai

# # =========================
# # JWT Authentication
# # =========================
# JWT_SECRET=YOUR_JWT_SECRET
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# # =========================
# # Google Gemini
# # =========================
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# # =========================
# # Groq
# # =========================
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# GROQ_MODEL=llama-3.3-70b-versatile

# # =========================
# # OpenRouter
# # =========================
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# OPENROUTER_MODEL=google/gemini-2.5-flash

# # =========================
# # GitHub Models
# # =========================
# GITHUB_TOKEN=YOUR_GITHUB_TOKEN
# GITHUB_MODEL=gpt-4o-mini

# # =========================
# # Google OAuth
# # =========================
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# # =========================
# # GitHub OAuth
# # =========================
# GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# # =========================
# # CORS
# # =========================
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://codesphere-ai-omega.vercel.app

# # =========================
# # Storage
# # =========================
# UPLOAD_DIR=./uploads
# CHROMA_PERSIST_DIR=./chromadb_data

# # =========================
# # Logging
# # =========================
# LOG_LEVEL=INFO


PROJECT_NAME="AI-Powered Software Engineering Assistant"
API_V1_STR="/api/v1"

# Allowed CORS Origins (Comma-separated list of origins)
# For development, include http://localhost:3000,http://localhost:5173
# For production, append your frontend vercel domain
# ALLOWED_ORIGINS=http://localhost:5173,https://codesphere-ai-omega.vercel.app,https://codesphere-5d5jbiy5z-sivagamiradhakrishnan21-5553s-projects.vercel.app

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.108:3000,https://codesphere-ai-omega.vercel.app,https://codesphere-5d5jbiy5z-sivagamiradhakrishnan21-5553s-projects.vercel.app

# MongoDB Database Configuration (Required)
# Use a local MongoDB instance or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=intellios_db

# JWT Security Settings (Required)
# Change the secret key to a strong random value in production
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Configuration (Optional, Google Sign-In is disabled if left blank)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Configuration (Optional/Required for GitHub Login)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/callback

# Gemini API Configuration (Required for agent capabilities)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Settings (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# GitHub Models Settings (Optional)
GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=gpt-4o-mini

# ChromaDB & Storage Directories
CHROMA_PERSIST_DIR=./chromadb_data
UPLOAD_DIR=./uploads