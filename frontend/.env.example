# =========================================================================
# Frontend Environment Configuration Example
# =========================================================================

# API Base URL (FastAPI Backend endpoint)
# Development: http://localhost:8000/api/v1
# Production: https://your-backend-api-domain.com/api/v1 (or leave blank if served from same domain)
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (Optional, Google Login will be disabled/hidden if left blank)
# Obtain this from Google Cloud Console (APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=750954225015-mh098docdn23hvh8jl2f05qms4pqf64e.apps.googleusercontent.com
